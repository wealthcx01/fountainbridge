# Env / secrets — never commit (D8: venture secrets live on the venture box, never here)
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key
secrets/

# Node / Next.js (arrives FB-005)
node_modules/
# The Railway SDK, linked in only while running `railway config plan` (FB-229, docs/deploy.md).
# No trailing slash: it is usually a symlink, and `node_modules/` matches only real folders.
.railway/node_modules
.next/
out/
build/
dist/
*.tsbuildinfo
.turbo/
coverage/
# next-env.d.ts is committed (stable, 4 lines) so the CI typecheck job has Next's ambient types
# without first running `next build`.

# Test / tooling caches
.eslintcache
playwright-report/
test-results/
e2e/__screenshots__/
.playwright/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
.gbrain-source

# gbrain writes these into whatever directory it is run from (FB-219). Neither belongs in the repo:
# .gbrain-owner.json carries a token, and notes/ is gbrain's own page store, not project
# documentation. Ignored rather than tidied away by hand, because the next `gbrain capture` recreates
# them and CLAUDE.md #8 says no credential is ever committed.
.gbrain-owner.json
/notes/

# Source reference material — kept locally (and on the VM) but NEVER committed:
# - reference-pdfs: Aulet (Disciplined Entrepreneurship) + Helmer (7 Powers) are licensed to us
#   for USE/guidance, not redistribution; also large binaries. Chapter authoring must produce
#   original, transformed markdown — not commit the source books.
# - media: workshop recordings (mp4/m4a) are hundreds of MB; transcripts (.vtt/.txt) are tracked.
docs/source/reference-pdfs/
*.mp4
*.m4a
.gstack/

# FB-106: `build/` above is meant for compiler output, and it silently swallowed a corpus fixture —
# because `build` is also a DEPARTMENT id in every venture manifest (Build / Sell / Scale), so a
# venture's `library/build/…` is a real content path. The e2e passed locally on a file git never
# received and only failed in CI, which is the expensive way to find this.
!e2e/fixtures/**

# FB-178: the generated ARCA-sized fixture (73 tickets, 1,773 run reports). Built on demand by
# scripts/make-scale-fixture.mjs; a fixture larger than the application does not belong in history.
e2e/__scale__/

# FB-233: the launch video's output. D8 — heavy binaries live in object storage with a pointer in
# git, and a re-cut would commit a new copy of a 157 KB binary every time. The pointer is
# library/launch-video/README.md, which IS tracked, and the command that reproduces the file is in
# it. Frames are intermediate and never kept.
library/launch-video/*.mp4
library/launch-video/*.png
library/launch-video/frames/

# FB-171: the local ActiveGraph used by `make activegraph-test`, and its Python caches.
.ag-venv/
__pycache__/
