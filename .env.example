# Foundry Studio env (FB-005). Copy to .env.local for dev. Real secrets live on the deployment
# env (Vercel) / venture box, never in the repo (D8). Auth wiring completes at deploy (FB-009).

# Auth.js — generate with `openssl rand -base64 32`
AUTH_SECRET=
# Set true off-Vercel (e.g. a VPS) so Auth.js trusts the host
AUTH_TRUST_HOST=true

# Google OAuth client (the Holy Corner vertical-login). Create in Google Cloud console;
# authorized redirect URI: https://<host>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bruntsfield admin emails (see all ventures) — comma/space separated. e.g. John's account.
STUDIO_ADMIN_EMAILS=john.gallagher@wealthcx.com

# Server-side GitHub read token (org-scoped PAT for v0; GitHub App is the production path).
# Used by lib/github to render lanes/tickets (FB-006/007/008). Never exposed to the browser.
GITHUB_TOKEN=

# Test-only: set to 1 to enable the credentials sign-in used by Playwright. NEVER in production.
# E2E_TEST_LOGIN=1

# --- Per-venture composer keys (FB-087) ----------------------------------------------------------
# One key per venture, because one box per venture (D1). The studio looks up
# COMPOSER_API_KEY_<VENTURE_ID>, upper-cased with non-alphanumerics as underscores — so `arca` is
# COMPOSER_API_KEY_ARCA and `the-reset` is COMPOSER_API_KEY_THE_RESET.
#
# Listed here because leaving it out is exactly how the composer came to be broken in production for
# weeks: nothing in the repo named the variable, so nobody noticed it was never set. Unset, the
# composer page returns an error to the founder; `/api/readiness` (admin) reports which venture is
# missing which key.
#
# Mint it on the venture's box with deploy/librechat/enable-agents-api.sh — it prints the key once.
# NEVER commit a real value. To run locally against the real box, prefer injecting the deployed
# environment instead of copying secrets to disk:
#     railway run --service foundry-studio npm start
#COMPOSER_API_KEY_ARCA=
