# The box's credential scan (FB-176). One pass, then exits.
#
# Runs as root because the places a credential has actually turned up include /root/.claude and
# /etc/systemd/system, and a scan that cannot read them would report a clean box it never looked at.
[Unit]
Description=Foundry — look for a credential outside its one home
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/foundry/secret-scan.mjs
# Non-zero is a finding, not a crash. systemd records the failure, `systemctl status` shows the
# lines, and the timer fires again tomorrow — the point is that it is noticed (CLAUDE.md #10).
SuccessExitStatus=0
Nice=15
