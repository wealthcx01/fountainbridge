# The box's credential scan (FB-176). One pass, then exits.
#
# Runs as root because the places a credential has actually turned up include /root/.claude and
# /etc/systemd/system, and a scan that cannot read them would report a clean box it never looked at.
[Unit]
Description=Foundry — look for a credential outside its one home
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# FB-206: where to tell the studio. lane.env names the venture's repo (REPO) and its base branch;
# the credentials file holds the token that can write to it. The same two files, in the same order,
# as foundry-lane.service — the credentials LAST, so a stale copy in lane.env cannot win.
# Both optional (`-`): a box missing either still scans and still exits non-zero on a finding; it
# just cannot report, and says so in the journal (exit 3 when the scan itself was clean).
EnvironmentFile=-/opt/foundry/lane/lane.env
EnvironmentFile=-/etc/foundry/credentials
# `--publish` writes health/secret-scan.json to the venture's foundry-state ref on EVERY run, clean or
# not, so the studio's admin ledger can tell a clean box from a scanner that has stopped running.
ExecStart=/opt/foundry/secret-scan.mjs --publish
# Non-zero is a finding, not a crash. systemd records the failure, `systemctl status` shows the
# lines, and the timer fires again tomorrow — the point is that it is noticed (CLAUDE.md #10).
SuccessExitStatus=0
Nice=15
