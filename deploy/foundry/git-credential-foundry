#!/usr/bin/env bash
# A git credential helper that reads the one home (FB-176).
#
# Without it there are two ways to give git a token and both leak:
#
#   - `git remote set-url origin https://x-access-token:<token>@github.com/…` writes it into
#     `.git/config` in plaintext, inside the working tree the venture brain indexes. That is where
#     ARCA's was found. `install-departments.sh` already strips it, but a clone made before that
#     still carries one, and nothing stops the next person typing it.
#   - `git push "https://x-access-token:<token>@…"` keeps it out of config but puts it on the process
#     command line, where `ps aux` prints it for anyone on the box.
#
# This gives git the token on stdin, which goes neither place. Install:
#
#   git config --global credential.https://github.com.helper /opt/foundry/git-credential-foundry
#
# Then `git push origin main` works against a tokenless remote and no secret is written or argued.
set -euo pipefail

HOME_FILE="${FOUNDRY_CREDENTIALS:-/etc/foundry/credentials}"

# git calls a helper with one of: get, store, erase. Only `get` does anything here — the credential
# is managed by rotation, not by git, so storing or erasing from git would be the wrong direction.
[ "${1:-}" = "get" ] || exit 0

[ -r "$HOME_FILE" ] || {
  # Loud, and to stderr so git shows it. A helper that exits quietly makes git fall through to
  # asking for a username on a machine with nobody at the keyboard, and the lane hangs.
  echo "git-credential-foundry: cannot read $HOME_FILE — is the box migrated? (deploy/foundry/README.md)" >&2
  exit 0
}

token="$(sed -n 's/^[[:space:]]*TICKET_GITHUB_TOKEN=//p' "$HOME_FILE" | tail -1 | sed 's/^"//; s/"$//')"
[ -n "$token" ] || {
  echo "git-credential-foundry: no TICKET_GITHUB_TOKEN in $HOME_FILE" >&2
  exit 0
}

# On stdout, to git, on a pipe. Never a file, never an argument.
printf 'username=x-access-token\npassword=%s\n' "$token"
