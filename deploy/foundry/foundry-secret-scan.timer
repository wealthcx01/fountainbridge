# Daily, and once shortly after boot (FB-176).
#
# Daily rather than hourly on purpose: the fault this catches is a credential written somewhere by
# accident and left there for weeks — ARCA's sat in three session transcripts across three weeks
# before anyone looked. A day's granularity finds that. An hourly scan of a whole filesystem buys
# nothing and costs a box that is also running a founder's composer.
[Unit]
Description=Foundry — daily credential scan

[Timer]
OnBootSec=10min
OnCalendar=daily
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
