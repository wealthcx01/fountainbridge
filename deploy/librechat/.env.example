# LibreChat env for a venture box (FB-025). Copy to `.env` on the box and fill in. NO SECRETS in the
# repo (non-negotiable 8) — real values live only on the venture's box. Docs:
# https://www.librechat.ai/docs/configuration

# --- identity / URL -----------------------------------------------------------------------------
# The venture's chat host (behind the box's Caddy TLS), e.g. https://chat.arca.<domain>.
DOMAIN_CLIENT=https://chat.<venture>.example
DOMAIN_SERVER=https://chat.<venture>.example

# --- branding: Bruntsfield Foundry (FB-025) -----------------------------------------------------
APP_TITLE=Bruntsfield Foundry
CUSTOM_FOOTER=Bruntsfield Capital · Foundry
HELP_AND_FAQ_URL=https://foundry-studio-production-4a73.up.railway.app/foundry

# --- secrets (generate on the box; see README) --------------------------------------------------
CREDS_KEY=            # 32-byte hex (openssl rand -hex 32)
CREDS_IV=             # 16-byte hex (openssl rand -hex 16)
JWT_SECRET=           # openssl rand -hex 32
JWT_REFRESH_SECRET=   # openssl rand -hex 32
MEILI_MASTER_KEY=     # openssl rand -hex 32

# --- reasoning: Claude via the Anthropic endpoint (portfolio standard) --------------------------
ANTHROPIC_API_KEY=    # the venture's Anthropic key
ENDPOINTS=anthropic,agents   # Claude, plus the agents endpoint (needed for the ticket-filing tool)

# --- write tool: the composer files an approved ticket to the venture backlog as a PR (FB-025) --
VENTURE_REPO=wealthcx01/arca
TICKET_GITHUB_TOKEN=  # fine-grained PAT with Contents:write + Pull requests:write on VENTURE_REPO
                      # (blank = the tool is installed but not yet authorized to file)
# FB-043 knowledge deposit (composer → git context/library). Optional — falls back to
# TICKET_GITHUB_TOKEN. Set a separate token here for least-privilege if you want.
DEPOSIT_GITHUB_TOKEN=

# --- web search (FB-035): the composer + research agent gather market/competitor/pricing context --
TAVILY_API_KEY=   # one Tavily key does search + scraping (tavily.com). Blank = search returns nothing.

# --- knowledge base (RAG, FB-034): chat over the founder's venture files --------------------------
# Embeddings run ON THE BOX (D1 isolation — file contents never leave the VM). No external key.
RAG_PORT=8000
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2   # local HuggingFace model (CPU)
POSTGRES_DB=foundry_rag
POSTGRES_USER=foundry
POSTGRES_PASSWORD=   # generate on the box: openssl rand -hex 24  (never in the repo)

# --- auth: locked to the venture's Google Workspace identity (Holy Corner pattern) --------------
# Password registration OFF — sign in only with the venture Workspace Google account.
ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=true
# Restrict Google sign-in to the venture Workspace domain (e.g. bruntsfield.capital until spin-out).
ALLOWED_REGISTRATION_DOMAINS=bruntsfield.capital
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/oauth/google/callback
