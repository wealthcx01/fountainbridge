# Foundry ticket-machine clean-up (FB-239). Removes every temporary ticket machine past its deadline.
#
# It asks the provider what exists, not a file on this box, so a machine whose run was killed outright
# is still found. It only ever acts on machines labelled foundry-role=ticket-worker; a venture's own
# machine has no such label and is never touched.
#
# Does nothing at all unless TICKET_MACHINES=on and HCLOUD_TOKEN are set (docs/ticket-machines.md).
[Unit]
Description=Foundry — remove temporary ticket machines past their deadline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/opt/foundry/lane/lane.env
EnvironmentFile=-/etc/foundry/credentials
WorkingDirectory=/opt/foundry/lane
ExecStart=/usr/bin/env node /opt/foundry/lane/ticket-machine.mjs reap
