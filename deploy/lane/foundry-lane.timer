# Foundry lane timer (FB-039). Wakes the supervisor on an interval — the pull-based trigger from
# docs/founder-to-lane-execution.md §4 (no inbound port needed; matches D1). NOT enabled by the
# spike; FB-040 enables it once the scan + "useful work?" pre-check + budget cap + gate are in.
[Unit]
Description=Wake the Foundry venture lane periodically

[Timer]
# Calendar cadence (every 5 min, §9.1). Chosen over monotonic OnBootSec/OnUnitActiveSec because those
# stall after a stop/restart once elapsed (NextElapse → infinity) — a calendar timer ALWAYS computes a
# next elapse regardless of boot/restart history, so the autonomous lane can't silently go dark.
# Type=oneshot service prevents overlap; Persistent catches a wake missed while the box was down.
OnCalendar=*:0/5
Persistent=true

[Install]
WantedBy=timers.target
