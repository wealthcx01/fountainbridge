# Foundry venture-brain bridge (FB-050). The composer's read-only door to the brain: gbrain owns a
# single-writer PGLite database on this host, so exactly one process gets to touch it on behalf of
# the containerised composer. See deploy/lane/brain-bridge.mjs.
[Unit]
Description=Foundry venture brain — read-only query bridge for the composer
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Bridge token + brain source + the lock the refresh also takes. Written by install-gbrain.sh; local
# to this box, never in the repo (§8).
EnvironmentFile=/opt/foundry/lane/brain.env
# gbrain is installed by bun into ~/.bun/bin, which is NOT on the PATH systemd hands a unit. Without
# this the bridge starts, answers /health, accepts queries — and every one of them fails with
# "flock: failed to execute gbrain: No such file or directory". The lane already prepends this in
# foundry-lib.sh; the bridge is a separate process and needed its own.
Environment=PATH=/root/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env node /opt/foundry/lane/brain-bridge.mjs
Restart=always
RestartSec=5
Nice=5
# A founder asking the composer a question must never be able to starve the box. The bridge answers
# one query at a time (brain-bridge.mjs), and the cgroup caps what that query's gbrain can take.
MemoryHigh=512M
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
