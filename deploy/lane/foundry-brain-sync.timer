# Refresh the venture brain on a cadence (FB-050).
[Unit]
Description=Refresh the Foundry venture brain periodically

[Timer]
# Calendar cadence, for the same reason as foundry-lane.timer: monotonic OnBootSec/OnUnitActiveSec
# timers stall after a stop/restart once elapsed, which would leave the brain silently frozen at
# whatever it knew before the restart. A calendar timer always computes a next elapse.
# Every 15 min — the lane resets the worktree to the base branch every ~5 min, so a merge is
# indexed well inside the founder's next question. Refresh defers while a lane run is in flight.
OnCalendar=*:0/15
Persistent=true

[Install]
WantedBy=timers.target
